    "osu-lazer",
    "danser",
    "danser-go",
    "replay",
    "recorder",
    "renderer",
    "beatmap",
    "autofetch"
  ],
  "author": "heiznerd <heiznerd@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nekoo-moe/danshi/issues"
  },
  "homepage": "https://github.com/nekoo-moe/danshi#readme",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "rosu-pp-js": "^4.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
