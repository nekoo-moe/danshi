{
  "name": "danshi",
  "version": "1.5.0",
  "description": "Automated osu! replay video renderer with multi-mirror beatmap auto-fetcher and smart skin manager for Danser-go.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "danshi": "./dist/cli.js",
    "danser-record": "./dist/cli.js",
    "danser-autofetch": "./dist/cli.js"
  },
  "scripts": {
